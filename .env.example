# Copy to .env. Every value has a default; nothing here is machine-specific.
# Comments sit on their own lines: in a .env file, text after a value is part of the value.

# Host port for the web UI.
AURUM_PORT=5024
# Host port for the MCP server over HTTP (for local MCP clients).
AURUM_MCP_HOST_PORT=5042
# Where ledgers, SQLite, the vault, secrets and documents live on the host.
AURUM_DATA_DIR_HOST=./data

# LLM provider: ollama | claude | openai | lm_studio.
AURUM_LLM_PROVIDER=ollama
# With AURUM_LLM_PROVIDER=claude, leave this default to use claude-opus-5-5.
AURUM_LLM_MODEL=llama3.1:8b
AURUM_EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://host.docker.internal:11434
# Cloud providers. Only used when AURUM_CLOUD_OPT_IN=1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 1 = allow calls to a cloud LLM provider (claude/openai); 0 refuses them all.
AURUM_CLOUD_OPT_IN=0

# Receipt photos: auto (Tesseract if installed, else the external OCR service) | tesseract | ocr-engine | off.
AURUM_OCR_BACKEND=auto
# Optional external OCR HTTP service used as the receipt OCR fallback, for example
# http://host.docker.internal:<port>. Empty = Tesseract only.
AURUM_OCR_URL=
# Tesseract languages, intersected with what is installed.
AURUM_OCR_LANGS=spa+eng
# Path to tesseract when it is not on PATH (the image installs it).
AURUM_TESSERACT_CMD=
# Seed the synthetic demo workspaces on first boot.
AURUM_SEED_DEMO=1
TZ=America/Mexico_City

# --- Security posture (docs/SECURITY.md) -------------------------------------------------------
# Where compose publishes the UI and MCP ports. 0.0.0.0 exposes them to the LAN; the API then
# REQUIRES a bearer token (auto-generated into data/secrets/api_token on first boot; read it with
# `docker compose exec api python -m aurum.core.token show`).
AURUM_BIND=127.0.0.1
# Explicit token (wins over the file). Empty + loopback bind = no token, protected by the
# Host/Origin guard only.
AURUM_API_TOKEN=
# 1 = require a token even on loopback (auto-generated if none).
AURUM_REQUIRE_TOKEN=0
# Separate bearer for the MCP endpoint; empty = same token as the API.
AURUM_MCP_TOKEN=
# Comma list of extra Host header values (e.g. nas.home,aurum.lan); loopback names, `api` and
# host.docker.internal are always allowed.
AURUM_ALLOWED_HOSTS=
# Comma list of browser origins that may call the API cross-origin (e.g. http://localhost:3000
# for `npm run dev`); empty = no CORS at all.
AURUM_ALLOWED_ORIGINS=
# uvicorn proxy trust; compose sets * because only nginx reaches the API.
AURUM_FORWARDED_ALLOW_IPS=*
# 1 = read-only public demo (blocks non-GET requests except a small allow-list).
AURUM_DEMO_MODE=0
# Request body cap in MB, enforced by nginx and by the API (streamed, chunked too).
AURUM_MAX_UPLOAD_MB=25
# Per-IP token bucket on /api/*; 0 disables it.
AURUM_RATE_LIMIT_PER_MIN=600
# Cap in MB on a research URL ingest body.
AURUM_FETCH_MAX_MB=10
# 1 = let research URL ingest reach LAN/private addresses (a NAS).
AURUM_ALLOW_PRIVATE_FETCH=0
# CFDI zip caps: members, MB per member, MB in total (uncompressed).
AURUM_ZIP_MAX_MEMBERS=500
AURUM_ZIP_MAX_MEMBER_MB=10
AURUM_ZIP_MAX_TOTAL_MB=100
# 0 = re-parse the Beancount files on every read (debugging).
AURUM_LEDGER_CACHE=1
# 1 = recursive chown of /data to the container user on boot (first migration of an old
# root-owned data dir; slow on big trees).
AURUM_CHOWN_DATA=0

# --- Optional Telegram channel (docs/tutorials/telegram-nudges.md) ------------------------------
# Bot token from @BotFather; empty = Telegram disabled.
TELEGRAM_BOT_TOKEN=
# Chat that scripts/telegram_nudges.py --send posts to.
TELEGRAM_CHAT_ID=
# Webhook routing, comma list of <chat_id>:<workspace_id>.
AURUM_TELEGRAM_WS_MAP=
# The secret_token you registered with setWebhook; set it before exposing the webhook.
AURUM_TELEGRAM_SECRET=
