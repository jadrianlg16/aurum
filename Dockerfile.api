# Aurum API — FastAPI + every Python module + MCP server (HTTP) in one container.
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /bin/
# Light OCR for receipt photos (aurum/ingest/receipt_ocr.py): the Tesseract CLI with Spanish + English.
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
COPY aurum ./aurum
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/drop-privileges.sh /drop-privileges.sh
RUN chmod +x /entrypoint.sh /drop-privileges.sh
# Non-root runtime user. No USER line on purpose: /drop-privileges.sh starts as root, fixes the
# ownership of the bind-mounted /data, then drops to `aurum` with setpriv (util-linux, in the base image).
ARG AURUM_UID=10001
ARG AURUM_GID=10001
RUN groupadd -r -g "${AURUM_GID}" aurum && useradd -r -u "${AURUM_UID}" -g aurum -d /app -s /usr/sbin/nologin aurum     && mkdir -p /data && chown aurum:aurum /data
ENV PATH="/app/.venv/bin:$PATH" AURUM_DATA_DIR=/data AURUM_API_HOST=0.0.0.0 AURUM_API_PORT=5041 HOME=/tmp
EXPOSE 5041 5042
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:%s/api/health'%os.environ.get('AURUM_API_PORT','5041'))" || exit 1
ENTRYPOINT ["/drop-privileges.sh"]
