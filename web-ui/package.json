{
  "name": "aurum-web-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "next build",
    "build:mock": "node scripts/build-mock.mjs",
    "start": "next start",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint . && npm run lint:ui",
    "lint:ui": "node scripts/check-i18n.mjs && node scripts/check-vocab.mjs && node scripts/contrast.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui-check": "node scripts/ui-check.mjs",
    "a11y": "node scripts/ui-check.mjs --a11y",
    "ui-check:flows": "node scripts/ui-check.mjs --flows",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.25",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
